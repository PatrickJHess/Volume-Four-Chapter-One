ools are amplified on a shared JupyterHub, where a single pooled cache can serve an entire class instantly.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"e2OjodhxGY"}],"key":"xndz3qmnAf"}],"key":"Vm2VV35j21"}],"key":"M38hwD5gdM"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Mastering these data access and caching strategies not only keeps your current notebooks running smoothly, but it also prepares you for the strict limitations of premium, institutional databases in the chapters to come.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"meND5GdYdq"}],"key":"kxxjdCdP1r"}],"key":"uUV6MIFTlg"}],"key":"pH6jhRBePD"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"📈 Getting Constant Maturity Yields From FRED","short_title":"📈 Getting Constant Maturity Yields From FRED","url":"/getting-constant-maturity-yields-from-fred","group":"Chapter One: Accessing Data With API Keys-Getting Data From FRED"},"next":{"title":"Imported Functions","short_title":"Imported Functions","url":"/imported-functions","group":"Chapter One: Accessing Data With API Keys-Getting Data From FRED"}}},"domain":"http://localhost:3000"}